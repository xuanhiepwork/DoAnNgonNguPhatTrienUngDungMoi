# =========================
# 1. DEPENDENCIES (Thư viện)
# =========================
# Bắt buộc phải bỏ qua vì chúng rất nặng và có thể cài lại bằng lệnh `npm install`
node_modules/
app/node_modules/
backend/node_modules/
later/node_modules/

# =========================
# 2. ENVIRONMENT VARIABLES (Biến môi trường)
# =========================
# CHỨA DỮ LIỆU NHẠY CẢM (Mật khẩu DB, Secret Keys, API Keys...) - TUYỆT ĐỐI KHÔNG PUSH LÊN GIT
.env
.env.*
!.env.example 
app/.env
app/.env.*
backend/.env
backend/.env.*

# =========================
# 3. BUILD OUTPUTS (File build/biên dịch)
# =========================
# Các file sinh ra khi bạn build React hoặc Node.js để chạy thực tế
app/dist/
app/build/
backend/dist/
backend/build/

# =========================
# 4. LOGS (File nhật ký)
# =========================
# Các file ghi lỗi sinh ra trong quá trình chạy npm/yarn hoặc server
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# 5. OS & EDITOR FILES (Cấu hình hệ điều hành và Trình soạn thảo)
# =========================
# Các file ẩn do hệ điều hành hoặc VSCode/WebStorm tự sinh ra cho cá nhân bạn
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# =========================
# 6. TESTING & COVERAGE (File test)
# =========================
coverage/
.nyc_output/